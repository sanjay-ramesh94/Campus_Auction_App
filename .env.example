# MongoDB Connection String (must be a replica set for transactions)
# For local replica set (via docker-compose or mongod --replSet rs0):
MONGODB_URI=mongodb://localhost:27017/campus_auction?replicaSet=rs0

# For MongoDB Atlas (Replica Set by default):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/campus_auction?retryWrites=true&w=majority

PORT=3000
NODE_ENV=development

# Gemini AI Assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
